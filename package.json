{
  "name": "runners-log",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "node scripts/generate-icons.mjs && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate": "wrangler d1 migrations apply runners-log-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply runners-log-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.14.0"
  }
}
